# App environment example
# Copy to .env or use CI secrets. Do NOT commit secret keys to version control.

# Stripe publishable key used by the client (non-secret)
STRIPE_PUBLISHABLE_KEY=pk_test_____________________

# API base URL for backend server (no trailing slash)
API_BASE_URL=http://localhost:4242

# Feature flags
ENABLE_PAYMENTS_TEST=true

# Build-time defines (can be passed via --dart-define)
# Example: flutter run --dart-define=APP_ENV=production --dart-define=STRIPE_PUBLISHABLE_KEY=pk_test_...
APP_ENV=development
